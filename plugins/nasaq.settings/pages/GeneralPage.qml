import QtQuick
import Quickshell
import Quickshell.Io
import "../../nasaq.commons"
import ".."

NPage {
  title: Tr.t("page.general")
  subtitle: "Language, layout direction and the NASAQ interface font."

  NSection {
    title: "LANGUAGE"
    NRow {
      title: "Interface language"
      subtitle: "NASAQ windows only. Omarchy's own panels stay in English."
      NDropdown {
        model: [{ value: "en", label: "English" }, { value: "ar", label: "العربية" }]
        value: Settings.get("general.language", "en")
        onActivated: function(v) { Settings.set("general.language", v) }
      }
    }
    NRow {
      title: "Right-to-left layout"
      subtitle: "Auto mirrors the layout when the language is Arabic."
      NDropdown {
        model: [{ value: "auto", label: "Auto" }, { value: "on", label: "Always" }, { value: "off", label: "Never" }]
        value: Settings.get("general.rtl", "auto")
        onActivated: function(v) { Settings.set("general.rtl", v) }
      }
    }
  }

  NSection {
    title: "FONT"
    note: "Used by NASAQ surfaces (settings window, new panels)."
    NRow {
      title: "Interface font"
      NDropdown {
        model: ["IBM Plex Sans Arabic", "Noto Kufi Arabic", "Noto Sans Arabic", "Cairo", "Adwaita Sans"]
        value: Settings.get("appearance.textFont", "IBM Plex Sans Arabic")
        onActivated: function(v) { Settings.set("appearance.textFont", v) }
      }
    }
  }

  NSection {
    title: "SCREENSHOTS"
    note: "PRINT captures; the screenshot is copied and saved, and its notification opens the editor (Tensaku)."
    NRow {
      title: "Take a screenshot"
      subtitle: "PRINT"
      NButton { text: "Capture"; onClicked: Sys.run("sleep 0.4; omarchy-capture-screenshot") }
    }
    NRow {
      title: "Edit the latest screenshot"
      subtitle: "Arrows, highlights, blur, text"
      NButton { text: "Edit"; onClicked: Sys.run("d=\"${OMARCHY_SCREENSHOT_DIR:-$(xdg-user-dir PICTURES 2>/dev/null || echo $HOME/Pictures)}\"; f=$(ls -t \"$d\"/*.png 2>/dev/null | head -1); [ -n \"$f\" ] && tensaku-edit \"$f\"") }
    }
    NRow {
      title: "Screenshots folder"
      NButton { text: "Open"; onClicked: Sys.run("omarchy-launch-nautilus \"$(xdg-user-dir PICTURES 2>/dev/null || echo $HOME/Pictures)\"") }
    }
  }

  NSection {
    title: "TEXT RECOGNITION (OCR)"
    note: "SUPER + CTRL + PRINT copies the text of a screen region."
    NRow {
      title: "Languages"
      NDropdown {
        model: [{ value: "ara+eng", label: "Arabic + English" }, { value: "eng", label: "English" }, { value: "ara", label: "Arabic" }]
        value: Settings.get("ocr.languages", "ara+eng")
        onActivated: function(v) {
          Settings.set("ocr.languages", v)
          Sys.run("printf -- '-- Generated by NASAQ Settings — do not edit by hand.\\nhl.env(\"OMARCHY_OCR_LANGS\", \"" + v + "\")\\n' > ~/.config/hypr/nasaq-env.lua && hyprctl reload && systemctl --user set-environment OMARCHY_OCR_LANGS=" + v)
        }
      }
    }
  }

  NSection {
    title: "SNAPSHOTS"
    note: "Every setting NASAQ owns is versioned. Restoring first saves the current state, so a restore can be undone."
    NRow {
      title: "Save the current settings"
      NButton { text: "Save…"; icon: "󰆓"; onClicked: Sys.term("nasaq-settings save --ask") }
    }
    NRow {
      title: "Go back to an earlier save"
      NButton { text: "Restore…"; icon: "󰋚"; onClicked: Sys.term("nasaq-settings restore") }
    }
    NRow {
      title: "Base settings"
      subtitle: "Return to the saved base."
      NButton { text: "Go to base"; danger: true; onClicked: Sys.term("nasaq-settings base") }
    }
  }
}
