#!/usr/bin/env python3
"""NASAQ: make letter keybindings work under the Arabic layout.

Hyprland matches letter binds by keysym, so under `ara` SUPER+W never fires.
This writes ~/.config/hypr/nasaq-binds-arabic.lua: for every binding that is
currently active and uses a Latin letter, the same binding on the key's
keycode (code:NN, layout-independent), then the letter version is unbound.
Each binding is added in its own pcall, and the letter version is removed only
if the code version was created, so a failure never loses a shortcut.

  nasaq-arabic-binds on     generate and reload Hyprland
  nasaq-arabic-binds off    empty the file and reload
  nasaq-arabic-binds status
"""
import json, os, re, subprocess, sys
from pathlib import Path

HOME = Path.home()
OUT = HOME / ".config/hypr/nasaq-binds-arabic.lua"
SOURCES = sorted(Path(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy"), "default/hypr/bindings").glob("*.lua")) + [HOME / ".config/hypr/bindings.lua"]
CODES = dict(zip("ABCDEFGHIJKLMNOPQRSTUVWXYZ", [38, 56, 54, 40, 26, 41, 42, 43, 31, 44, 45, 46, 58, 57, 32, 33, 24, 27, 39, 28, 30, 55, 25, 53, 29, 52]))
MODBITS = {"SUPER": 64, "SHIFT": 1, "CTRL": 4, "CONTROL": 4, "ALT": 8}
BIND = re.compile(r'^\s*o\.bind\("([^"]+)"(.*)\)\s*$')

def norm(combo):
    parts = [p.strip().upper() for p in combo.split("+")]
    key = parts[-1]
    mask = 0
    for p in parts[:-1]:
        mask |= MODBITS.get(p, 0)
    return mask, key

def active():
    out = subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True).stdout
    return {(b["modmask"], b["key"].upper()) for b in json.loads(out or "[]") if b.get("key")}

def user_overridden():
    # Combos the user unbinds or rebinds by hand stay theirs.
    t = (HOME / ".config/hypr/bindings.lua").read_text(errors="ignore")
    return {norm(c) for c in re.findall(r'hl\.unbind\("([^"]+)"\)', t)}

def generate():
    live, mine = active(), user_overridden()
    lines, seen = [], set()
    for src in SOURCES:
        for raw in src.read_text(errors="ignore").splitlines():
            m = BIND.match(raw)
            if not m or raw.count("(") != raw.count(")"):
                continue
            combo, rest = m.group(1), m.group(2)
            mask, key = norm(combo)
            if key not in CODES or (mask, key) not in live or (mask, key) in seen:
                continue
            if src.name != "bindings.lua" and (mask, key) in mine:
                continue
            seen.add((mask, key))
            code_combo = re.sub(r"\b" + key + r"$", "code:%d" % CODES[key], combo.strip(), flags=re.I)
            lines.append('safe(%s, function() o.bind(%s%s) end)' % (json.dumps(combo), json.dumps(code_combo), rest))
    head = ['-- Generated by nasaq-arabic-binds (NASAQ Settings > Shortcuts). Do not edit by hand.',
            '-- Letter bindings re-created on keycodes so they work under the Arabic layout.',
            'local function safe(letter, add)',
            '  local ok, err = pcall(add)',
            '  if ok then pcall(hl.unbind, letter) else print("nasaq-arabic-binds: " .. letter .. ": " .. tostring(err)) end',
            'end', '']
    OUT.write_text("\n".join(head + lines) + "\n")
    return len(lines)

cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
if cmd == "on":
    OUT.write_text("")                       # measure the stock binds, not our own previous output
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    n = generate()
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    print(f"on: {n} bindings now work under the Arabic layout")
elif cmd == "off":
    OUT.write_text("-- Arabic-safe bindings are off (NASAQ Settings > Shortcuts).\n")
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    print("off")
else:
    t = OUT.read_text() if OUT.exists() else ""
    print("on" if "safe(" in t else "off")
