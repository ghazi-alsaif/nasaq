#!/usr/bin/env python3
"""NASAQ display settings with a safety net (NASAQ Settings > System > Displays).

  nasaq-display list                         monitors with modes, scale, transform (JSON)
  nasaq-display apply <out> <mode> <scale> [transform]
        writes ~/.config/hypr/nasaq-monitors.lua, reloads Hyprland, and reverts
        after 15 s unless `nasaq-display keep` is run (the settings window asks).
  nasaq-display keep                         keep the new settings
  nasaq-display revert                       go back now
  nasaq-display reset <out>                  drop NASAQ's override for that output (monitors.lua applies again)
"""
import json, os, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
OUT = HOME / ".config/hypr/nasaq-monitors.lua"
STATE = HOME / ".local/state/nasaq"
BACKUP, PENDING = STATE / "monitors.lua.bak", STATE / "display-pending"
DB = STATE / "monitors.json"   # {output: {mode, scale, transform}}
HEADER = "-- Generated by nasaq-display (NASAQ Settings > System). Do not edit by hand.\n"

def mons():
    return json.loads(subprocess.run(["hyprctl", "monitors", "all", "-j"], capture_output=True, text=True).stdout or "[]")

def write(db):
    lines = [HEADER]
    for out, c in sorted(db.items()):
        t = f", transform = {int(c.get('transform', 0))}" if int(c.get("transform", 0)) else ""
        lines.append(f'hl.monitor({{ output = {json.dumps(out)}, mode = {json.dumps(c["mode"])}, position = "auto", scale = {float(c["scale"])}{t} }})')
    OUT.write_text("\n".join(lines) + "\n")

def load():
    try: return json.loads(DB.read_text())
    except Exception: return {}

def reload(): subprocess.run(["hyprctl", "reload"], capture_output=True)

cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
STATE.mkdir(parents=True, exist_ok=True)
if cmd == "list":
    print(json.dumps([{"name": m["name"], "description": m.get("description", ""), "mode": f'{m["width"]}x{m["height"]}@{m["refreshRate"]:.2f}Hz',
                       "modes": m.get("availableModes", []), "scale": round(m["scale"], 3), "transform": m.get("transform", 0),
                       "overridden": m["name"] in load()} for m in mons()]))
elif cmd == "apply" and len(sys.argv) >= 5:
    out, mode, scale = sys.argv[2], sys.argv[3].replace("Hz", ""), float(sys.argv[4])
    transform = int(sys.argv[5]) if len(sys.argv) > 5 else 0
    BACKUP.write_text(OUT.read_text() if OUT.exists() else HEADER)
    (STATE / "monitors.json.bak").write_text(json.dumps(load()))
    db = load(); db[out] = {"mode": mode, "scale": scale, "transform": transform}
    DB.write_text(json.dumps(db)); write(db); reload()
    token = str(time.time()); PENDING.write_text(token)
    # Detached watchdog: revert unless confirmed within 15 s.
    subprocess.Popen(["bash", "-c", 'sleep 15; [ "$(cat "$1" 2>/dev/null)" = "$2" ] && "$3" revert', "nasaq", str(PENDING), token, sys.argv[0]], start_new_session=True)
    print("applied; run `nasaq-display keep` within 15 s")
elif cmd == "keep":
    PENDING.unlink(missing_ok=True); print("kept")
elif cmd == "revert":
    if BACKUP.exists(): OUT.write_text(BACKUP.read_text())
    bak = STATE / "monitors.json.bak"
    if bak.exists(): DB.write_text(bak.read_text())
    PENDING.unlink(missing_ok=True); reload(); print("reverted")
elif cmd == "reset" and len(sys.argv) == 3:
    db = load(); db.pop(sys.argv[2], None); DB.write_text(json.dumps(db)); write(db); reload(); print("reset")
else:
    sys.exit(__doc__)
