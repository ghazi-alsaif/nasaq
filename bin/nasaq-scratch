#!/usr/bin/env python3
"""NASAQ named scratchpads (NASAQ Settings > Workspaces & Windows).

Each scratchpad is a window that lives on its own hidden special workspace and
slides in over whatever you are doing with one key.
  nasaq-scratch apply      write ~/.config/hypr/nasaq-scratchpads.lua from settings and reload
  nasaq-scratch <name>     show/hide that scratchpad (starts it the first time)
Settings: scratchpads = [{name, command, title|class, key, width, height}]
"""
import json, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
SETTINGS = HOME / ".config/omarchy/nasaq/settings.json"
OUT = HOME / ".config/hypr/nasaq-scratchpads.lua"
DEFAULT = [{"name": "term", "command": "ptyxis --standalone --new-window -T 'NASAQ Scratch'", "title": "NASAQ Scratch",
            "key": "SUPER + code:49", "width": 1400, "height": 760}]

def pads():
    try:
        p = json.loads(SETTINGS.read_text()).get("scratchpads")
    except Exception:
        p = None
    return p if isinstance(p, list) else DEFAULT

def lua(s): return json.dumps(s, ensure_ascii=False)

def apply():
    lines = ["-- Generated by nasaq-scratch (NASAQ Settings > Workspaces & Windows). Do not edit by hand.", ""]
    for p in pads():
        n = p["name"]
        match = {"title": "^" + p["title"] + "$"} if p.get("title") else {"class": "^" + p.get("class", n) + "$"}
        m = ", ".join(f"{k} = {lua(v)}" for k, v in match.items())
        lines.append(f'o.window({{ {m} }}, {{ workspace = {lua("special:" + n + " silent")}, float = true, center = true, size = {lua(str(p.get("width", 1200)) + " " + str(p.get("height", 700)))} }})')
        if p.get("key"):
            lines.append(f'o.bind({lua(p["key"])}, {lua("Scratchpad: " + n)}, {lua(str(HOME / ".local/bin/nasaq-scratch") + " " + n)})')
    OUT.write_text("\n".join(lines) + "\n")
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    print(f"{len(pads())} scratchpads")

def clients():
    return json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True).stdout or "[]")

def toggle(name):
    p = next((x for x in pads() if x["name"] == name), None)
    if not p:
        sys.exit(f"no scratchpad named {name}")
    ws = "special:" + name
    toggle_cmd = f'hl.dsp.workspace.toggle_special({lua(name)})'
    if any(c["workspace"]["name"] == ws for c in clients()):
        subprocess.run(["hyprctl", "dispatch", toggle_cmd], capture_output=True); return
    subprocess.Popen(["uwsm-app", "--", "bash", "-c", p["command"]], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(50):                       # wait up to 5 s for the window to map
        time.sleep(0.1)
        if any(c["workspace"]["name"] == ws for c in clients()):
            subprocess.run(["hyprctl", "dispatch", toggle_cmd], capture_output=True); return

if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else "apply"
    apply() if arg == "apply" else toggle(arg)
