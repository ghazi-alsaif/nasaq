#!/bin/bash
# Make the NASAQ login screen and boot/shutdown screens follow the active
# Omarchy theme.
#   sudo /usr/local/bin/nasaq-login-sync
# Runs as root (the SDDM and Plymouth theme folders are root's) through the one
# sudoers rule NASAQ's installer adds for the installing user, from the
# theme-set hook and at the end of the install steps. It takes no arguments.
# It reads the theme's colours and the wallpaper of the user who called sudo:
#   login screen  /usr/share/sddm/themes/nasaq-login: theme.conf, background.jpg
#   boot screens  /usr/share/plymouth/themes/nasaq: images rendered in the theme
#                 colours, nasaq.script and nasaq.plymouth from their templates;
#                 the boot image (initramfs) is rebuilt once when they changed
# Each part is skipped when its folder is missing. Runs are serialised.
#
# Safety: every user file is read by the user (runuser), never by root, so a
# symlink swapped in after the checks cannot make root copy a file the user
# could not read. Paths are resolved with readlink -f and must be regular files
# under the user's home or /usr/share/omarchy.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
if (( EUID != 0 )); then exec sudo -n /usr/local/bin/nasaq-login-sync; fi

DST=/usr/share/sddm/themes/nasaq-login
PDST=/usr/share/plymouth/themes/nasaq
die() { echo "nasaq-login-sync: $1" >&2; exit 1; }
login=false; plymouth=false
[[ -d $DST && ! -L $DST ]] && login=true
[[ -d $PDST && ! -L $PDST && -d $PDST/templates ]] && plymouth=true
$login || $plymouth || die "neither the NASAQ login screen nor the boot screens are installed"
# One run at a time (the theme-set hook starts it in the background).
exec 9>/run/lock/nasaq-login-sync.lock
flock 9
user=${SUDO_USER:-}
[[ -n $user && $user != root ]] || die "run it through sudo as the desktop user"
home=$(getent passwd "$user" | cut -d: -f6)
uid=$(id -u "$user")
[[ -d $home ]] || die "no home for $user"

allowed() {   # allowed <resolved path>: a regular file in a place we trust
  [[ -f $1 && ! -L $1 ]] || return 1
  case $1 in "$home"/*|/usr/share/omarchy/*) return 0 ;; esac
  return 1
}
as_user() { runuser -u "$user" -- "$@"; }

# Root writes only into rtmp (root's, mode 0700). The user's ImageMagick writes
# into utmp, and its output is read back by the user, so nothing the user can
# plant in utmp (a symlink, say) is ever written through by root.
rtmp=$(mktemp -d)
utmp=$(mktemp -d)
trap 'rm -rf "${rtmp:?}" "${utmp:?}"' EXIT
chown "$user" "$utmp"

# Theme colours (Omarchy 4 keeps the current theme in ~/.local/state).
colors=""
for d in "$home/.local/state/omarchy/current/theme" "$home/.config/omarchy/current/theme"; do
  c=$(readlink -f "$d/colors.toml" 2>/dev/null || true)
  if [[ -n $c ]] && allowed "$c"; then colors=$c; break; fi
done
toml=""
[[ -n $colors ]] && toml=$(as_user cat "$colors" 2>/dev/null || true)
# Same reading as Omarchy's shell (Commons/Color.qml), so the login screen gets
# exactly the colours the lock screen gets from Color.*: named keys first, then
# color0 / color7 / color4; urgent is the last "red" or "color1" in the file.
declare -A col=()
urgent=""
while IFS='=' read -r k v; do
  col[$k]=$v
  [[ $k == red || $k == color1 ]] && urgent=$v
done < <(sed -n 's/^[[:space:]]*\([A-Za-z0-9_-]*\)[[:space:]]*=[[:space:]]*["'"'"']\{0,1\}\(#[0-9A-Fa-f]\{6\}\).*/\1=\2/p' <<<"$toml")
background=${col[background]:-${col[color0]:-#101315}}
fg=${col[foreground]:-${col[color7]:-#cacccc}}
accent=${col[accent]:-${col[color4]:-#cacccc}}
urgent=${urgent:-#a55555}
surface=$background   # Omarchy exposes no lighter shade; both screens use background

# Monitor scale of the user's session, so the pills match the lock screen.
scale=$(as_user env XDG_RUNTIME_DIR="/run/user/$uid" hyprctl -i 0 monitors -j 2>/dev/null \
  | jq -r '[.[] | select(.focused)][0].scale // .[0].scale // 1' 2>/dev/null || true)
[[ $scale =~ ^[0-9]+([.][0-9]+)?$ ]] || scale=1

# Wallpaper: blurred like the lock screen. ImageMagick runs as the user.
wall=""
for w in "$home/.local/state/omarchy/current/background" "$home/.config/omarchy/current/background"; do
  r=$(readlink -f "$w" 2>/dev/null || true)
  if [[ -n $r ]] && allowed "$r"; then wall=$r; break; fi
done
if [[ -n $wall ]]; then
  if command -v magick >/dev/null; then
    as_user magick "$wall" -resize '2560x1440^' -gravity center -extent 2560x1440 -blur 0x20 -quality 85 "$utmp/background.jpg" &&
      as_user cat "$utmp/background.jpg" > "$rtmp/background.jpg" || true
  elif [[ $wall == *.jpg || $wall == *.jpeg ]]; then
    as_user cat "$wall" > "$rtmp/background.jpg" || true
  fi
fi

if $login; then
  cat > "$rtmp/theme.conf" <<EOF
[General]
uiScale=$scale
background=background.jpg
surface="$surface"
fg="$fg"
accent="$accent"
rainColor="$accent"
urgent="$urgent"
EOF
  install -o root -g root -m 0644 "$rtmp/theme.conf" "$DST/theme.conf"
  if [[ -s $rtmp/background.jpg ]]; then install -o root -g root -m 0644 "$rtmp/background.jpg" "$DST/background.jpg"; fi
  echo "login screen follows the theme: accent $accent, text $fg, scale $scale${wall:+, wallpaper ${wall##*/}}"
fi

$plymouth || exit 0

# ── Boot and shutdown screens (Plymouth) ─────────────────────────────────────
# The images are rendered by the user (ImageMagick, the user's fonts) from the
# root-owned templates into utmp/ply, read back by the user into rtmp/ply, and
# only then installed by root. Words in JetBrains Mono, like the lock screen's
# clock, date and pills.
mkdir -p "$rtmp/ply"
as_user mkdir -p "$utmp/ply"
# Shown name, the same rule as the lock and login screens: the full name from
# the first GECOS field if set, else the user name as it is. A leading "@"
# would make ImageMagick read a file, so it is dropped.
shown=$(getent passwd "$user" | cut -d: -f5 | cut -d, -f1 | tr -d '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; s/^@*//')
[[ -n $shown ]] || shown=$user
as_user bash -s -- "$PDST/templates" "$utmp/ply" "$fg" "$accent" "$background" "$shown" "$wall" <<'RENDER' || die "could not render the boot screen images"
set -euo pipefail
tpl=$1 out=$2 fg=$3 accent=$4 bg=$5 name=$6 wall=$7
cd "$out"
# Font files through fontconfig, so the name ImageMagick expects does not matter:
# plain JetBrains Mono on one machine, the Nerd Font build on another, and any
# monospace font when neither is installed.
font() {   # font <Regular|Medium|Bold>: path of the font file to use
  local f
  for q in "JetBrains Mono:style=$1" "JetBrainsMono Nerd Font:style=$1" "JetBrainsMono NF:style=$1" "monospace:style=$1"; do
    f=$(fc-match -f '%{file}' "$q" 2>/dev/null)
    [[ -n $f && -r $f ]] && { printf '%s' "$f"; return; }
  done
  fc-match -f '%{file}' monospace
}
F_REGULAR=$(font Regular); F_MEDIUM=$(font Medium); F_BOLD=$(font Bold)
word() {   # word <text> <weight> <size> <opacity> <file>
  local ff; case $2 in Bold) ff=$F_BOLD ;; Medium) ff=$F_MEDIUM ;; *) ff=$F_REGULAR ;; esac
  magick -background none -fill "$fg" -font "$ff" -pointsize "$3" label:"$1" \
    -channel A -evaluate multiply "$4" +channel "$5"
}
word "Hello" Regular 140 0.95 hello.png
word "See you soon" Regular 120 0.95 soon.png
word "Goodbye" Regular 140 0.95 goodbye.png
word "Unlock to start up" Medium 28 0.9 sub.png
word "Restarting" Medium 28 0.9 sub-reboot.png
word "Shutting down" Medium 28 0.9 sub-shutdown.png
word "Password" Bold 13 0.85 placeholder.png
for f in entry bullet progress_box progress_bar; do
  magick "$tpl/$f.png" -fill "$fg" -colorize 100 "$f.png"
done
# Rain: the old drops' shapes and alpha in the accent, the way the lock and
# login screens draw it; the bright head of each drop in a lighter accent.
light=$(awk -v r=$((16#${accent:1:2})) -v g=$((16#${accent:3:2})) -v b=$((16#${accent:5:2})) \
  'BEGIN { printf "#%02x%02x%02x", r + (255 - r) * 0.45, g + (255 - g) * 0.45, b + (255 - b) * 0.45 }')
for i in 0 1 2 3 4 5 6 7; do
  magick "$tpl/trail$i.png" -fill "$accent" -colorize 100 body.png
  magick "$tpl/trail$i.png" -fill "$light" -colorize 100 head.png
  magick "$tpl/trail$i.png" -alpha off -colorspace gray -threshold 85% mask.png
  # The head keeps its own alpha, limited to the bright pixels.
  magick head.png \( +clone -alpha extract mask.png -compose multiply -composite \) \
    -alpha off -compose CopyOpacity -composite headm.png
  magick body.png headm.png -compose over -composite "trail$i.png"
done
rm -f body.png head.png headm.png mask.png
# Name pill, like the lock screen's: glass pill, accent avatar with the initial.
initial=$(printf '%s' "${name:0:1}" | tr '[:lower:]' '[:upper:]')
rgb=$(magick xc:"$fg" -format '%[fx:int(255*r)],%[fx:int(255*g)],%[fx:int(255*b)]' info:)
magick -background none -fill "$fg" -font "$F_BOLD" -pointsize 14 label:"$name" name.png
magick -size 18x18 xc:none -fill "$accent" -draw "circle 8.5,8.5 8.5,0" \
  -fill "$bg" -font "$F_BOLD" -pointsize 11 -gravity center -annotate +0+0 "$initial" avatar.png
nw=$(magick identify -format %w name.png); x0=$(( (190 - 25 - nw) / 2 )); (( x0 > 4 )) || x0=4
magick -size 190x34 xc:none -fill "rgba($rgb,0.20)" -stroke "rgba($rgb,0.22)" -strokewidth 1 \
  -draw "roundrectangle 0.5,0.5 189.5,33.5 16.5,16.5" \
  avatar.png -gravity west -geometry "+$x0+0" -composite \
  name.png -gravity west -geometry "+$((x0 + 25))+0" -composite namepill.png
rm -f name.png avatar.png
if [[ -n $wall ]]; then
  magick "$wall" -resize '1920x1080^' -gravity center -extent 1920x1080 -blur 0x20 background.png
else
  magick -size 1920x1080 xc:"$bg" background.png
fi
# No timestamps in the files, so an unchanged theme gives identical bytes and
# the boot image is only rebuilt when something really changed.
for f in *.png; do magick "$f" -define png:exclude-chunks=date,time "$f"; done
RENDER
for f in "$utmp"/ply/*.png; do
  n=${f##*/}
  [[ $n =~ ^[a-z0-9_-]+\.png$ ]] || continue
  as_user cat "$f" > "$rtmp/ply/$n"
done
# Script and theme file from the templates, with the theme colours filled in.
frac() {   # "#rrggbb" -> "r, g, b" as 0..1 fractions, the way Plymouth wants them
  awk -v r=$((16#${1:1:2})) -v g=$((16#${1:3:2})) -v b=$((16#${1:5:2})) 'BEGIN { printf "%.3f, %.3f, %.3f", r/255, g/255, b/255 }'
}
sed -e "s/@BG_RGB@/$(frac "$background")/" -e "s/@URGENT_RGB@/$(frac "$urgent")/" "$PDST/templates/nasaq.script.in" > "$rtmp/ply/nasaq.script"
sed -e "s/@CONSOLE_BG@/0x${background:1}/" "$PDST/templates/nasaq.plymouth.in" > "$rtmp/ply/nasaq.plymouth"

# Checksums of the rendered files (none yet on the first run, hence nullglob and || true).
sums() { (shopt -s nullglob; cd "$PDST" && sha256sum -- *.png nasaq.script nasaq.plymouth 2>/dev/null || true) | sort; }
before=$(sums)
for f in "$rtmp"/ply/*; do install -o root -g root -m 0644 "$f" "$PDST/${f##*/}"; done
after=$(sums)

if [[ $before == "$after" ]]; then
  echo "boot screens unchanged; boot image not rebuilt"
elif [[ $(plymouth-set-default-theme 2>/dev/null) != nasaq ]]; then
  echo "boot screens updated (not the active Plymouth theme, so the boot image was not rebuilt)"
else
  if command -v limine-mkinitcpio >/dev/null; then limine-mkinitcpio >/dev/null 2>&1; else mkinitcpio -P >/dev/null 2>&1; fi \
    && echo "boot screens updated; boot image rebuilt" \
    || die "boot screens updated, but rebuilding the boot image failed"
fi
