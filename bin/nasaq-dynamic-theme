#!/usr/bin/env python3
"""NASAQ: make an Omarchy theme from a wallpaper (Material You colours via matugen).

  nasaq-dynamic-theme [IMAGE] [--light] [--style tonal|vibrant|expressive|neutral] [--apply]
  nasaq-dynamic-theme --back      return to the theme that was active before

Writes ~/.config/omarchy/themes/nasaq-dynamic/ (colors.toml, backgrounds/, icons.theme).
Interface colours come from the wallpaper; the 16 terminal colours are kept from the
theme you started from, so code stays readable. Omarchy then themes every app as usual.
"""
import json, re, shutil, subprocess, sys
from pathlib import Path

H = Path.home()
CUR = H / ".local/state/omarchy/current"
DST = H / ".config/omarchy/themes/nasaq-dynamic"
STATE = H / ".local/state/nasaq/dynamic-theme.json"
args = sys.argv[1:]

def current_theme():
    return subprocess.run(["omarchy", "theme", "current"], capture_output=True, text=True).stdout.strip()

def slug(s): return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")

if "--back" in args:
    st = json.loads(STATE.read_text()) if STATE.exists() else {}
    base = st.get("base")
    if base: subprocess.run(["omarchy", "theme", "set", base]); print("back to", base)
    sys.exit()

img = next((a for a in args if not a.startswith("--") and a not in ("tonal", "vibrant", "expressive", "neutral")), None)
img = Path(img) if img else (CUR / "background").resolve()
mode = "light" if "--light" in args else "dark"
style = {"tonal": "scheme-tonal-spot", "vibrant": "scheme-vibrant", "expressive": "scheme-expressive", "neutral": "scheme-neutral"}.get(
    args[args.index("--style") + 1] if "--style" in args else "tonal", "scheme-tonal-spot")

st = json.loads(STATE.read_text()) if STATE.exists() else {}
cur = slug(current_theme())
base = st.get("base") if cur == "nasaq-dynamic" else cur
base_dir = next((d for d in [H / ".config/omarchy/themes" / base, Path("/usr/share/omarchy/themes") / base] if d.exists()), None)
base_colors = (CUR / "theme/colors.toml").read_text() if cur != "nasaq-dynamic" or not base_dir else (base_dir / "colors.toml").read_text()
ansi = dict(re.findall(r'^(\w+)\s*=\s*"(#[0-9A-Fa-f]{6})"', base_colors, re.M))

out = subprocess.run(["matugen", "image", str(img), "-j", "hex", "--dry-run", "-m", mode, "-t", style, "--prefer", "saturation"],
                     capture_output=True, text=True)
c = {k: v[mode]["color"] for k, v in json.loads(out.stdout)["colors"].items()}
pal = {
    "accent": c["primary"], "selection": c["primary_container"], "muted": c["outline"],
    "background": c["surface"], "dark_background": c["surface_container_low"], "darker_background": c["surface_container_lowest"],
    "lighter_background": c["surface_container_high"],
    "foreground": c["on_surface"], "dark_foreground": c["on_surface_variant"], "light_foreground": c["on_surface"], "bright_foreground": c["inverse_surface"] if mode == "dark" else c["on_surface"],
}
keys = ["red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown", "bright_red", "bright_yellow", "bright_green", "bright_cyan", "bright_blue", "bright_magenta"]
lines = [f'mode = "{mode}"', ""] + [f'{k} = "{v}"' for k, v in pal.items()] + [""] + [f'{k} = "{ansi[k]}"' for k in keys if k in ansi]
lines.append(f'blue = "{c["primary"]}"') if "blue" not in ansi else None
DST.mkdir(parents=True, exist_ok=True)
(DST / "colors.toml").write_text("\n".join(lines) + "\n")
bgd = DST / "backgrounds"; shutil.rmtree(bgd, ignore_errors=True); bgd.mkdir()
shutil.copy2(img, bgd / ("wallpaper" + img.suffix.lower()))
if base_dir and (base_dir / "icons.theme").exists(): shutil.copy2(base_dir / "icons.theme", DST / "icons.theme")
STATE.parent.mkdir(parents=True, exist_ok=True)
STATE.write_text(json.dumps({"base": base, "image": str(img), "mode": mode, "style": style}))
print(f"nasaq-dynamic from {img.name} ({mode}, {style}); base theme {base}")
if "--apply" in args:
    subprocess.run(["omarchy", "theme", "set", "nasaq-dynamic"])
