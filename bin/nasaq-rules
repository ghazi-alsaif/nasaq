#!/usr/bin/env python3
"""NASAQ window rules (NASAQ Settings > Workspaces & Windows), written to
~/.config/hypr/nasaq-rules.lua from settings.windowRules = [{class, float, center,
width, height, workspace, opacity, pin}].  `nasaq-rules apply` writes and reloads."""
import json, subprocess
from pathlib import Path
H = Path.home(); S = H / ".config/omarchy/nasaq/settings.json"; OUT = H / ".config/hypr/nasaq-rules.lua"
try: rules = json.loads(S.read_text()).get("windowRules") or []
except Exception: rules = []
lines = ["-- Generated by nasaq-rules (NASAQ Settings > Workspaces & Windows). Do not edit by hand.", ""]
for r in rules:
    if not r.get("class"): continue
    o = {}
    if r.get("float"): o["float"] = True
    if r.get("center"): o["center"] = True
    if r.get("pin"): o["pin"] = True
    if r.get("width") and r.get("height"): o["size"] = f'{int(r["width"])} {int(r["height"])}'
    if r.get("workspace"): o["workspace"] = str(r["workspace"])
    if r.get("opacity"): o["opacity"] = f'{float(r["opacity"]):.2f} {float(r["opacity"]):.2f}'; o["tag"] = "-default-opacity"
    if not o: continue
    body = ", ".join(f"{k} = {json.dumps(v)}" for k, v in o.items())
    lines.append(f'pcall(o.window, {{ class = {json.dumps("^" + r["class"] + "$")} }}, {{ {body} }})')
OUT.write_text("\n".join(lines) + "\n")
subprocess.run(["hyprctl", "reload"], capture_output=True)
print(f"{len(lines) - 2} rules")
