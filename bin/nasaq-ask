#!/usr/bin/env python3
"""NASAQ: ask Claude from Spotlight ("? question").
Prints JSON {"answer": str, "command": str|null}. A command is only suggested
when it matches the allow-list below; Spotlight runs it only after Enter.
"""
import json, re, subprocess, sys
ALLOW = re.compile(r"^(omarchy[ -][\w -]+|nasaq-[\w-]+( [\w.:+\"' -]*)?|systemctl --user (start|stop|restart|status) [\w.@-]+|"
                   r"hyprctl dispatch [\w.:\"(){}=, -]+|brightnessctl set \d+%|wpctl set-(volume|mute) @DEFAULT_AUDIO_SINK@ [\w.%+-]+|"
                   r"playerctl (play|pause|play-pause|next|previous)|powerprofilesctl set (performance|balanced|power-saver)|"
                   r"omarchy-shell [\w.-]+ [\w-]+( [\w\"'{}:,. -]*)?|notify-send .+|sleep \d+ && .+)$")
q = " ".join(sys.argv[1:]).strip()
if not q:
    print(json.dumps({"answer": "", "command": None})); sys.exit()
prompt = (
  "You are the assistant inside NASAQ, a desktop shell on Omarchy (Arch Linux, Hyprland 0.56 with Lua config). "
  "Answer the user's request briefly (max 3 sentences, same language as the user). If the request is an action on this desktop "
  "that ONE shell command can do, also give that command. Prefer `omarchy ...` commands (e.g. `omarchy toggle nightlight`, "
  "`omarchy theme set <name>`, `omarchy capture screenshot`, `omarchy reminder <minutes> \"text\"`, `omarchy-system-lock`), "
  "`powerprofilesctl set ...`, `wpctl set-volume @DEFAULT_AUDIO_SINK@ 50%`, `playerctl ...`. Reply with ONLY a JSON object: "
  '{"answer": "...", "command": "..." or null}.\n\nRequest: ' + q)
try:
    out = subprocess.run(["nasaq-agent-ask", prompt], capture_output=True, text=True, timeout=95).stdout
    m = re.search(r"\{.*\}", out, re.S)
    data = json.loads(m.group(0)) if m else {"answer": out.strip(), "command": None}
except Exception as e:
    data = {"answer": f"The agent did not answer ({e.__class__.__name__}).", "command": None}
cmd = (data.get("command") or "").strip()
if cmd and not ALLOW.match(cmd):
    data["answer"] = (data.get("answer") or "") + f"  (Suggested command not allowed here: {cmd})"
    cmd = ""
print(json.dumps({"answer": data.get("answer") or "", "command": cmd or None}, ensure_ascii=False))
