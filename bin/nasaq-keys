#!/usr/bin/env python3
"""NASAQ shortcut editor backend (NASAQ Settings > Shortcuts).

Moves any existing shortcut — Omarchy's, NASAQ's or your own — to a new key,
or turns it off, without knowing what it does: ~/.config/hypr/nasaq-remap.lua
is loaded before every binding and redirects bindings registered on the old
keys to the new ones.
  nasaq-keys list                     every shortcut as JSON [{keys, description, changed}]
  nasaq-keys set "<old>" "<new>"      e.g. set "SUPER + W" "SUPER + code:24"   ("" = turn off)
  nasaq-keys reset "<old>"            back to the default
  nasaq-keys apply                    rewrite nasaq-remap.lua from settings and reload
  nasaq-keys check "<new>"            print what already uses those keys (empty = free)
"""
import json, re, subprocess, sys
from pathlib import Path

HOME = Path.home()
SETTINGS = HOME / ".config/omarchy/nasaq/settings.json"
OUT = HOME / ".config/hypr/nasaq-remap.lua"
CODE_NAMES = {**{c: l for l, c in zip("ABCDEFGHIJKLMNOPQRSTUVWXYZ", [38, 56, 54, 40, 26, 41, 42, 43, 31, 44, 45, 46, 58, 57, 32, 33, 24, 27, 39, 28, 30, 55, 25, 53, 29, 52])},
              **{10 + i: str((i + 1) % 10) for i in range(10)}, 49: "GRAVE", 20: "MINUS", 21: "EQUAL", 59: "COMMA", 60: "PERIOD", 61: "SLASH",
              65: "SPACE", 36: "RETURN", 23: "TAB", 9: "ESCAPE", 22: "BACKSPACE", 110: "HOME", 115: "END", 119: "DELETE", 107: "PRINT",
              111: "UP", 113: "LEFT", 114: "RIGHT", 116: "DOWN", 34: "BRACKETLEFT", 35: "BRACKETRIGHT", 47: "SEMICOLON", 48: "APOSTROPHE", 51: "BACKSLASH"}
MODS = ["SUPER", "CTRL", "SHIFT", "ALT"]

def canon(k):
    parts = [p for p in re.split(r"[+\s]+", str(k).upper()) if p]
    if not parts: return ""
    key = parts[-1]
    m = re.fullmatch(r"CODE:(\d+)", key)
    if m: key = CODE_NAMES.get(int(m.group(1)), key)
    mods = {("CTRL" if p in ("CONTROL", "CTRL") else p) for p in parts[:-1]}
    return " + ".join([x for x in MODS if x in mods] + [key])

def load():
    try: return json.loads(SETTINGS.read_text())
    except Exception: return {}

def save(d): SETTINGS.write_text(json.dumps(d, indent=2, ensure_ascii=False) + "\n")

def remap():
    return (load().get("shortcuts") or {}).get("remap") or {}

def listing():
    out = subprocess.run(["omarchy", "menu", "keybindings", "--print"], capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        if "→" not in line: continue
        keys, desc = [x.strip() for x in line.split("→", 1)]
        rows.append({"keys": canon(keys), "description": desc})
    return rows

def apply():
    r = remap()
    lines = ["-- Generated by nasaq-keys (NASAQ Settings > Shortcuts). Do not edit by hand.",
             "-- Old keys (canonical form) → new keys; \"\" turns the shortcut off.", "return {"]
    for old, new in sorted(r.items()):
        lines.append(f"  [{json.dumps(canon(old))}] = {json.dumps(new)},")
    lines.append("}")
    OUT.write_text("\n".join(lines) + "\n")
    subprocess.run(["hyprctl", "reload"], capture_output=True)
    # Letter shortcuts moved by the remap must be re-derived for the Arabic layout.
    if subprocess.run(["nasaq-arabic-binds", "status"], capture_output=True, text=True).stdout.strip() == "on":
        subprocess.run(["nasaq-arabic-binds", "on"], capture_output=True)

def check(new):
    c = canon(new)
    return [r["description"] for r in listing() if r["keys"] == c]

cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
if cmd == "list":
    r = {canon(k): v for k, v in remap().items()}
    moved_to = {canon(v): k for k, v in r.items() if v}
    print(json.dumps([dict(x, changed=moved_to.get(x["keys"], "")) for x in listing()] +
                     [{"keys": k, "description": "(turned off)", "changed": k} for k, v in r.items() if not v], ensure_ascii=False))
elif cmd == "set" and len(sys.argv) == 4:
    clash = check(sys.argv[3]) if sys.argv[3] else []
    if clash: sys.exit("in use by: " + ", ".join(clash))
    d = load(); d.setdefault("shortcuts", {}).setdefault("remap", {})[canon(sys.argv[2])] = sys.argv[3]; save(d); apply(); print("ok")
elif cmd == "reset" and len(sys.argv) == 3:
    d = load(); (d.get("shortcuts") or {}).get("remap", {}).pop(canon(sys.argv[2]), None); save(d); apply(); print("ok")
elif cmd == "apply": apply(); print("ok")
elif cmd == "check" and len(sys.argv) == 3: print("\n".join(check(sys.argv[2])))
else: sys.exit(__doc__)
