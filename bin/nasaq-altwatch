#!/usr/bin/env python3
"""NASAQ: report the Alt keys' state straight from the kernel (evdev), so the
app switcher knows the instant Alt goes up — Hyprland never reports that.

Prints one line per change: "down" / "up". The first line is the current
state. Needs read access to /dev/input/event* (udev rule 69-nasaq-input.rules).
"""
import glob, os, select, struct, sys, time
from fcntl import ioctl

KEY_LEFTALT, KEY_RIGHTALT = 56, 100
EV_KEY = 1
EVENT = struct.Struct("llHHi")
KEY_MAX = 0x2ff
EVIOCGKEY = 0x80000000 | ((KEY_MAX // 8 + 1) << 16) | (ord("E") << 8) | 0x18

def keyboards():
    fds = {}
    for dev in glob.glob("/dev/input/event*"):
        try:
            fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            caps = bytearray(KEY_MAX // 8 + 1)
            ioctl(fd, EVIOCGKEY, caps)                       # also proves it is a key device
            fds[fd] = dev
        except OSError:
            continue
    return fds

def alt_down(fds):
    for fd in fds:
        try:
            st = bytearray(KEY_MAX // 8 + 1); ioctl(fd, EVIOCGKEY, st)
            if st[KEY_LEFTALT >> 3] >> (KEY_LEFTALT & 7) & 1 or st[KEY_RIGHTALT >> 3] >> (KEY_RIGHTALT & 7) & 1:
                return True
        except OSError:
            pass
    return False

def main():
    fds = keyboards()
    if not fds:
        print("unavailable", flush=True); return 1
    state = alt_down(fds)
    print("down" if state else "up", flush=True)
    held = {KEY_LEFTALT: False, KEY_RIGHTALT: False}
    last_scan = time.time()
    while True:
        r, _, _ = select.select(list(fds), [], [], 5.0)
        for fd in r:
            try:
                data = os.read(fd, EVENT.size * 64)
            except OSError:
                os.close(fd); fds.pop(fd, None); continue
            for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, etype, code, value = EVENT.unpack_from(data, off)
                if etype == EV_KEY and code in held and value in (0, 1):
                    held[code] = value == 1
                    new = held[KEY_LEFTALT] or held[KEY_RIGHTALT]
                    if new != state:
                        state = new
                        print("down" if state else "up", flush=True)
        if time.time() - last_scan > 5:                     # pick up keyboards plugged in later
            last_scan = time.time()
            for fd, dev in keyboards().items():
                if dev not in fds.values(): fds[fd] = dev
                else: os.close(fd)

if __name__ == "__main__":
    sys.exit(main())
