#!/usr/bin/env python3
"""NASAQ automations (NASAQ Settings > AI & Automation): scheduled commands as
systemd user timers named nasaq-auto-<name>. settings.automations =
[{name, command, schedule (systemd OnCalendar, e.g. "daily", "Mon *-*-* 09:00"), enabled}].
  nasaq-auto apply    create/update/remove the timers to match settings
  nasaq-auto list     timers with their next run (JSON)"""
import json, re, subprocess, sys
from pathlib import Path
H = Path.home(); S = H / ".config/omarchy/nasaq/settings.json"; U = H / ".config/systemd/user"
def sysd(*a): return subprocess.run(["systemctl", "--user", *a], capture_output=True, text=True)
try: autos = json.loads(S.read_text()).get("automations") or []
except Exception: autos = []
cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
if cmd == "apply":
    U.mkdir(parents=True, exist_ok=True)
    want = set()
    for a in autos:
        n = re.sub(r"[^a-z0-9-]", "-", str(a.get("name", "")).lower()).strip("-")
        if not n or not a.get("command") or not a.get("schedule"): continue
        unit = f"nasaq-auto-{n}"; want.add(unit)
        (U / f"{unit}.service").write_text(f"[Unit]\nDescription=NASAQ automation: {a['name']}\n\n[Service]\nType=oneshot\nExecStart=/bin/bash -lc {json.dumps(a['command'])}\n")
        (U / f"{unit}.timer").write_text(f"[Unit]\nDescription=NASAQ automation timer: {a['name']}\n\n[Timer]\nOnCalendar={a['schedule']}\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n")
    for f in U.glob("nasaq-auto-*.timer"):
        if f.stem not in want:
            sysd("disable", "--now", f.name); f.unlink(missing_ok=True); (U / f"{f.stem}.service").unlink(missing_ok=True)
    sysd("daemon-reload")
    for a in autos:
        n = re.sub(r"[^a-z0-9-]", "-", str(a.get("name", "")).lower()).strip("-")
        if f"nasaq-auto-{n}" in want: sysd("enable" if a.get("enabled", True) else "disable", "--now", f"nasaq-auto-{n}.timer")
    print(f"{len(want)} automations")
else:
    out = sysd("list-timers", "--all", "--output=json", "nasaq-auto-*").stdout
    print(out.strip() or "[]")
