# NASAQ boot and shutdown screens, in the same look as the lock and login
# screens: blurred wallpaper, a greeting per mode (Hello / See you soon /
# Goodbye), the name pill, looping Matrix rain in the middle band, and the
# disk-unlock password pill. Layout is authored for 1920x1080 and scaled.
#
# Generated by nasaq-login-sync from nasaq.script.in: every colour comes from
# the active Omarchy theme (the images are rendered in its colours, and the
# @…@ values below are filled in), so do not edit the installed copy.

W = Window.GetWidth();
H = Window.GetHeight();
sc = H / 1080;
cx = W / 2;

Window.SetBackgroundTopColor(@BG_RGB@);
Window.SetBackgroundBottomColor(@BG_RGB@);

bg.image = Image("background.png").Scale(W, H);
bg.sprite = Sprite(bg.image);
bg.sprite.SetPosition(0, 0, -100);

#----------------------------------------- Greeting --------------------------------
# Boot says Hello with the name pill; restart says See you soon, shutdown Goodbye.

mode = Plymouth.GetMode();
if (mode == "shutdown") { sub_file = "sub-shutdown.png"; big_file = "goodbye.png"; }
else if (mode == "reboot") { sub_file = "sub-reboot.png"; big_file = "soon.png"; }
else { sub_file = "sub.png"; big_file = "hello.png"; }

# Same layout as the lock screen: centred on these y positions (1080p).
fun place_center(file, cy, z) {
  img = Image(file);
  img = img.Scale(img.GetWidth() * sc, img.GetHeight() * sc);
  spr = Sprite(img);
  spr.SetPosition(cx - img.GetWidth() / 2, cy * sc - img.GetHeight() / 2, z);
  return spr;
}

sub.sprite = place_center(sub_file, 202, 10);
big.sprite = place_center(big_file, 305, 10);
if (mode == "boot" || mode == "resume") {
  namepill.sprite = place_center("namepill.png", 470, 10);
}

#----------------------------------------- Matrix rain --------------------------------

band.top = 560 * sc;
band.bottom = 960 * sc;
band.fade = (band.bottom - band.top) * 0.28;
band.width = 620 * sc;
band.left = cx - band.width / 2;

for (t = 0; t < 8; t++)
  trail.images[t] = Image("trail" + t + ".png").Scale(20 * sc, Image("trail" + t + ".png").GetHeight() * sc);

cols = Math.Int(band.width / (20 * sc));
for (c = 0; c < cols; c++) {
  drop[c].sprite = Sprite(trail.images[Math.Int(Math.Random() * 8) % 8]);
  drop[c].x = band.left + c * 20 * sc;
  drop[c].y = band.top - 260 * sc + Math.Random() * (band.bottom - band.top + 260 * sc);
  drop[c].speed = (0.9 + Math.Random() * 1.9) * sc;
  # Columns near the sides stay fainter, like the lock screen's side fade.
  edge = c / cols;
  if (edge > 0.5) edge = 1 - edge;
  drop[c].maxop = Math.Clamp(edge / 0.10, 0, 1) * 0.85;
  drop[c].sprite.SetPosition(drop[c].x, drop[c].y, 5);
  drop[c].sprite.SetOpacity(0);
}

fun update_rain() {
  for (c = 0; c < cols; c++) {
    drop[c].y += drop[c].speed;
    h = drop[c].sprite.GetImage().GetHeight();
    if (drop[c].y > band.bottom) {
      drop[c].sprite.SetImage(trail.images[Math.Int(Math.Random() * 8) % 8]);
      drop[c].y = band.top - drop[c].sprite.GetImage().GetHeight() - Math.Random() * 120 * sc;
      drop[c].speed = (0.9 + Math.Random() * 1.9) * sc;
      h = drop[c].sprite.GetImage().GetHeight();
    }
    # Fade by where the bright head is inside the band.
    head = drop[c].y + h;
    op = Math.Min((head - band.top) / band.fade, (band.bottom - head) / band.fade);
    drop[c].sprite.SetOpacity(Math.Clamp(op, 0, 1) * drop[c].maxop);
    drop[c].sprite.SetY(drop[c].y);
  }
}

#----------------------------------------- Password pill --------------------------------

entry.image = Image("entry.png").Scale(230 * sc, 34 * sc);
entry.sprite = Sprite(entry.image);
entry.x = cx - entry.image.GetWidth() / 2;
entry.y = 517 * sc - entry.image.GetHeight() / 2;
entry.sprite.SetPosition(entry.x, entry.y, 20);
entry.sprite.SetOpacity(0);

placeholder.image = Image("placeholder.png");
placeholder.image = placeholder.image.Scale(placeholder.image.GetWidth() * sc, placeholder.image.GetHeight() * sc);
placeholder.sprite = Sprite(placeholder.image);
placeholder.sprite.SetPosition(cx - placeholder.image.GetWidth() / 2, entry.y + entry.image.GetHeight() / 2 - placeholder.image.GetHeight() / 2, 21);
placeholder.sprite.SetOpacity(0);

bullet.image = Image("bullet.png").Scale(8 * sc, 8 * sc);
bullet.sprites = [];
max_bullets = 12;

message.sprite = Sprite();
message.sprite.SetPosition(0, entry.y + entry.image.GetHeight() + 10 * sc, 21);

fun hide_password() {
  entry.sprite.SetOpacity(0);
  placeholder.sprite.SetOpacity(0);
  for (i = 0; bullet.sprites[i]; i++) bullet.sprites[i].SetOpacity(0);
}

#----------------------------------------- Progress (after unlock) --------------------------------

progress_box.image = Image("progress_box.png").Scale(180 * sc, 6 * sc);
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetPosition(cx - progress_box.image.GetWidth() / 2, entry.y + entry.image.GetHeight() / 2 - 3 * sc, 20);
progress_box.sprite.SetOpacity(0);

progress_bar.original = Image("progress_bar.png").Scale(180 * sc, 6 * sc);
progress_bar.sprite = Sprite();
progress_bar.sprite.SetPosition(cx - progress_box.image.GetWidth() / 2, entry.y + entry.image.GetHeight() / 2 - 3 * sc, 21);
progress_bar.sprite.SetOpacity(0);

global.password_shown = 0;
global.fake_active = 0;
global.fake_frame = 0;
global.max_progress = 0;

fun set_progress(p) {
  if (p <= global.max_progress) return;
  global.max_progress = p;
  w = Math.Int(progress_bar.original.GetWidth() * p);
  if (w < 6 * sc) w = 6 * sc;
  progress_bar.sprite.SetImage(progress_bar.original.Scale(w, progress_bar.original.GetHeight()));
}

fun show_progress() {
  progress_box.sprite.SetOpacity(1);
  progress_bar.sprite.SetOpacity(1);
}

#----------------------------------------- Callbacks --------------------------------

fun refresh_callback() {
  update_rain();
  if (global.fake_active == 1) {
    global.fake_frame++;
    r = global.fake_frame / 50.0 / 15.0;
    if (r > 1) r = 1;
    set_progress((1 - (1 - r) * (1 - r)) * 0.7);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun display_password_callback(prompt, bullets) {
  global.password_shown = 1;
  global.fake_active = 0;
  progress_box.sprite.SetOpacity(0);
  progress_bar.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(1);
  if (bullets == 0) placeholder.sprite.SetOpacity(1);
  else placeholder.sprite.SetOpacity(0);

  for (i = 0; bullet.sprites[i]; i++) bullet.sprites[i].SetOpacity(0);
  n = bullets;
  if (n > max_bullets) n = max_bullets;
  # Dots stay centred in the pill as they grow, like the lock screen.
  start = cx - (n * 12 * sc - 4 * sc) / 2;
  for (i = 0; i < n; i++) {
    if (!bullet.sprites[i]) bullet.sprites[i] = Sprite(bullet.image);
    bullet.sprites[i].SetPosition(start + i * 12 * sc, entry.y + entry.image.GetHeight() / 2 - 4 * sc, 22);
    bullet.sprites[i].SetOpacity(1);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  hide_password();
  mode = Plymouth.GetMode();
  if ((mode == "boot" || mode == "resume") && global.password_shown == 1) {
    show_progress();
    global.fake_active = 1;
  }
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun progress_callback(duration, progress) {
  if (global.password_shown == 1 && progress > global.max_progress) {
    if (progress > 0.7) global.fake_active = 0;
    set_progress(progress);
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

fun display_message_callback(text) {
  img = Image.Text(text, @URGENT_RGB@);
  message.sprite.SetImage(img);
  message.sprite.SetX(cx - img.GetWidth() / 2);
  message.sprite.SetOpacity(1);
}
fun hide_message_callback(text) {
  message.sprite.SetOpacity(0);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
