#!/bin/bash

# Matrix screensaver for Omarchy, in muted green.
#
# Same as the stock `omarchy-screensaver` except it pins ttfx to the `matrix`
# effect instead of picking a random one each loop, and dims every colour the
# effect uses. Defaults are much brighter: highlight dbffdb, rain 92be92/185318,
# final 92be92/336b33.
#
# Enable/disable with: screensaver-mode matrix|ascii|status

# Bottom of each falling rain column -- the brightest pixel on screen.
HIGHLIGHT=${MATRIX_HIGHLIGHT:-9ab89a}
# Colours the falling rain is drawn from, bright-to-dark.
RAIN=(${MATRIX_RAIN:-6b8f6b 1c2b1c})
# Colours the resolved logo settles into, bright-to-dark.
FINAL=(${MATRIX_FINAL:-7d9f7d 2b3f2b})
# Seconds of rain before it resolves into the logo (ttfx default is 15).
RAIN_TIME=${MATRIX_RAIN_TIME:-12}
# Seconds to hold the resolved logo on screen before the next cycle. Without
# this the loop restarts the instant ttfx exits, so the logo you spent 12
# seconds resolving is visible for only a moment.
HOLD=${MATRIX_HOLD:-8}

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # black background

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

# Terminals allocate the pty at 80x24 and only resize it once the compositor has
# told the window how big it is. ttfx measures the terminal once, at startup, so
# starting it too early sizes an 80x24 canvas inside a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

# Moving the mouse or clicking ends it too, like any screensaver. The stock
# loop only ends on a key (or a middle-click paste): ask kitty to report every
# mouse move and button to the terminal (any-motion tracking, SGR encoding),
# where the `read` below sees it. The pointer entering the new window can send
# one report as it maps, so give it a moment and drop what arrived.
printf '\033[?1003h\033[?1006h'
sleep 0.6
while read -r -n1 -t 0.05; do :; done

while true; do
  ttfx -i ~/.config/omarchy/branding/screensaver.txt \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --no-eol --no-restore-cursor \
    matrix \
    --highlight-color "$HIGHLIGHT" \
    --rain-time "$RAIN_TIME" \
    --rain-color-gradient "${RAIN[@]}" \
    --final-gradient-stops "${FINAL[@]}" \
    --final-gradient-direction vertical &

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done

  # ttfx leaves its final frame on screen, so hold it there before looping.
  for ((held = 0; held < HOLD; held++)); do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done
